{
  "schema": "frc-design-kernel/design@1",
  "name": "Bench lifter",
  "units": {"length": "mm", "mass": "kg"},
  "frame": "Origin on the bench top under the middle of the base plate. +X toward the fork tips, +Y left, +Z up.",
  "parameters": {
    "base_t": 8,
    "post_x": -120,
    "post_y": 110,
    "post_d": 30,
    "post_top": "=base_t + 450",
    "lift": 220,
    "fork_z": 95,
    "tine_len": 180
  },
  "groups": {
    "base": {"role": "structure"},
    "drive": {"role": "mechanism"},
    "carriage": {"role": "mechanism", "carriedBy": "base", "massKg": 1.8,
                 "note": "One lump figure for the whole carriage until its parts are chosen."},
    "load": {"role": "payload", "carriedBy": "carriage"},
    "fixtures": {"role": "fixture"}
  },
  "custom": {
    "tine": {
      "reason": "A fork tine has a curved underside so it slides under a crate; no listed shape has a curved edge.",
      "limits": "Side outline only. The curve is one arc chosen by eye, not a stress-checked profile."
    }
  },
  "solids": [
    {"name": "base plate", "group": "base", "densityKgM3": 2700,
     "shape": {"kind": "box", "fromMm": [-200, -150, 0], "toMm": [200, 150, "=base_t"]}},
    {"name": "post {side}", "group": "base", "densityKgM3": 2700,
     "each": [{"side": "left", "s": 1}, {"side": "right", "s": -1}],
     "shape": {"kind": "tube", "section": "round", "fromMm": ["=post_x", "=s * post_y", "=base_t"],
               "toMm": ["=post_x", "=s * post_y", "=post_top"], "outerDiameterMm": "=post_d", "wallMm": 2}},
    {"name": "top bar", "group": "base", "densityKgM3": 2700,
     "shape": {"kind": "tube", "section": "rectangular", "fromMm": ["=post_x", "=-post_y - 15", "=post_top + 12.5"],
               "toMm": ["=post_x", "=post_y + 15", "=post_top + 12.5"], "widthMm": 25, "heightMm": 25, "wallMm": 2}},
    {"name": "gusset {side}", "group": "base", "densityKgM3": 2700,
     "each": [{"side": "left", "s": 1}, {"side": "right", "s": -1}],
     "shape": {"kind": "prism", "plane": "xz",
               "outlineMm": [["=post_x + post_d / 2", "=base_t"], ["=post_x + 75", "=base_t"], ["=post_x + post_d / 2", "=base_t + 60"]],
               "fromMm": "=s * (post_y - 3)", "toMm": "=s * (post_y + 3)"}},
    {"name": "gearmotor body", "group": "drive", "massKg": 0.62,
     "part": {"file": "parts/gearmotor.step", "solid": "Motor body"},
     "place": [{"kind": "translation", "travelMm": [60, -60, "=base_t + 22"]}]},
    {"name": "gearmotor shaft", "group": "drive", "massKg": 0.03,
     "part": {"file": "parts/gearmotor.step", "solid": "Output shaft"},
     "place": [{"kind": "translation", "travelMm": [60, -60, "=base_t + 22"]}]},
    {"name": "spool", "group": "drive", "note": "Mass not yet known.",
     "shape": {"kind": "cylinder", "fromMm": [60, 35, "=base_t + 22"], "toMm": [60, 65, "=base_t + 22"], "radiusMm": 15}},
    {"name": "sleeve {side}", "group": "carriage",
     "each": [{"side": "left", "s": 1}, {"side": "right", "s": -1}],
     "shape": {"kind": "tube", "section": "round", "fromMm": ["=post_x", "=s * post_y", 75],
               "toMm": ["=post_x", "=s * post_y", 155], "outerDiameterMm": "=post_d + 10", "wallMm": 4}},
    {"name": "carriage plate", "group": "carriage",
     "shape": {"kind": "box", "fromMm": ["=post_x + 20", "=-post_y - 20", 85], "toMm": ["=post_x + 26", "=post_y + 20", 145]}},
    {"name": "tine {side}", "group": "carriage",
     "each": [{"side": "left", "s": 1}, {"side": "right", "s": -1}],
     "shape": {"kind": "custom", "use": "tine", "parameters": {"lengthMm": "=tine_len", "widthMm": 20, "rootMm": 24, "tipMm": 6}},
     "place": [{"kind": "translation", "travelMm": ["=post_x + 26", "=s * 60 - 10", "=fork_z"]}]}
  ],
  "fixtures": [
    {"name": "bench top", "part": {"file": "parts/bench.step", "solid": "Bench top"}},
    {"name": "crate", "group": "load", "massKg": 2.5,
     "shape": {"kind": "box", "fromMm": [-60, -70, "=fork_z"], "toMm": [60, 70, "=fork_z + 100"]}}
  ],
  "mounts": [
    {"group": "carriage", "member": "sleeve {side}", "on": "post {side}", "atMm": ["=post_x", "=s * post_y", 100],
     "each": [{"side": "left", "s": 1}, {"side": "right", "s": -1}],
     "note": "The sleeve slides on the post."},
    {"group": "drive", "member": "gearmotor body", "on": "base plate", "atMm": [60, -25, "=base_t"],
     "note": "Motor clamp bolts to the base plate."},
    {"group": "load", "member": "crate", "on": "tine left", "atMm": [0, 60, "=fork_z"],
     "note": "The crate rests on both tines."}
  ],
  "pieces": {
    "bar": {"note": "A round steel bar laid across the tines.",
            "shape": {"kind": "cylinder", "fromMm": [0, -150, 0], "toMm": [0, 150, 0], "radiusMm": 15},
            "massKg": {"value": 0.4, "measured": "Weighed on the shop scale (invented for this example)."}}
  },
  "materials": {
    "steel": {"note": "The bar against the lifter's steel parts.",
              "stiffnessNPerM": {"value": 200000, "assumed": [100000, 400000]},
              "restitution": {"value": 0.2, "assumed": [0.1, 0.4]},
              "friction": {"value": 0.4, "assumed": [0.2, 0.6]}}
  },
  "motors": {
    "bench gearmotor": {"note": "The motor inside the gearmotor, before its gearbox. Invented figures.",
                        "ktNmPerA": {"value": 0.012, "assumed": [0.011, 0.013]},
                        "ohm": {"value": 0.6, "assumed": [0.5, 0.7]},
                        "keVsPerRad": {"value": 0.012, "assumed": [0.011, 0.013]}}
  },
  "drives": {
    "hoist": {"note": "The spool winds a cord that pulls the carriage up the posts.",
              "motor": "bench gearmotor", "motorSolid": "gearmotor body", "gear": 30,
              "efficiency": {"value": 0.8, "assumed": [0.7, 0.9]}, "supplyLimitA": 20,
              "joint": {"group": "carriage", "kind": "slide", "axis": [0, 0, 1], "perOutputTurn": "=2 * pi * 15", "travel": [0, "=lift"]}}
  },
  "contacts": [
    {"pair": ["crate", "tine {side}"], "each": [{"side": "left"}, {"side": "right"}],
     "note": "The crate rests on the tines until it is handed off."},
    {"pair": ["gearmotor shaft", "spool"], "note": "The spool is pinned to the shaft end."}
  ],
  "poses": {
    "lowered": {},
    "raised": {"carriage": [{"kind": "translation", "travelMm": [0, 0, "=lift"]}]},
    "set down": {
      "carriage": [{"kind": "translation", "travelMm": [0, 0, "=lift"]}],
      "load": [{"kind": "translation", "travelMm": [260, 0, 0]}]
    }
  },
  "motions": {
    "lift": {"from": "lowered", "to": "raised", "drive": {"hoist": {"to": "=lift"}},
             "durationS": {"value": 1.5, "assumed": [1.0, 2.5]}},
    "hand off": {"from": {"after": "lift"}, "to": "set down", "by": "hand",
                 "note": "The crate is lifted off the tines by hand along one arc.",
                 "moves": {"load": [{"kind": "path", "curve": "arc",
                                     "throughMm": [[0, 0, 350], [130, 0, 400], [260, 0, 350]]}]}},
    "whole cycle": {"through": ["lowered", "raised", "set down"], "by": "hand",
                    "note": "The whole cycle as one smooth sweep, for a quick look."}
  },
  "adjustments": {
    "fork height": {"input": "parameters.fork_z", "kind": "mechanical", "range": [85, 105], "step": 5,
                    "note": "The tines bolt to the carriage plate through a row of holes."}
  },
  "interactions": {
    "bar on the tines": {
      "piece": "bar", "plane": {"normal": "y", "atMm": 60}, "solids": ["tine left", "carriage plate"],
      "guides": ["post left", "post right"], "pieceAtMm": [["=post_x + 26 + 15", 0, "=fork_z + 15"]], "motions": ["lift"],
      "approach": {"angleDeg": [-5, 5], "offsetMm": [-10, 10], "note": "Laid on by hand."}, "targetOffPlane": false
    }
  },
  "trials": {
    "bar stays on the tines": {
      "note": "A round bar lies across the tines against the carriage plate. The lifter is braked; the bar must stay put.",
      "assumes": [{"id": "bar-square", "text": "The bar lies square across both tines and does not slew."}],
      "plane": {"normal": "y", "atMm": 60},
      "stepS": 0.0001, "durationS": 1.5, "traceS": 0.01, "fitToleranceMm": 2,
      "piece": {"use": "bar", "start": {"atMm": ["=post_x + 26 + 15", "=fork_z + 15"]}},
      "surfaces": [
        {"solid": "tine left", "material": "steel"},
        {"solid": "carriage plate", "material": "steel"}
      ],
      "loads": [{"name": "braking", "along": [1, 0], "accelerationMps2": 3, "startS": 0.2, "durationS": 0.3,
                 "note": "The frame speeds up toward +X, so the bar is pressed back against the plate."}],
      "events": [
        {"name": "rolled off", "when": {"signal": "zMm", "below": "=fork_z - 40"}, "outcome": "rolled off the tines"},
        {"name": "stayed", "when": {"all": [{"signal": "tS", "above": 0.8}, {"restFor": 0.3}]}, "outcome": "stayed"}
      ],
      "measures": {"travelX": {"final": "xMm"}, "pressN": {"peak": "contact.carriage plate.forceN"}},
      "pass": {"outcomes": ["stayed"]},
      "control": {"change": {"loads.braking.accelerationMps2": -6},
                  "note": "Braked the other way, nothing stops the bar and it must roll off the tips."},
      "brackets": [{"input": "loads.braking.accelerationMps2", "unit": "m/s2", "values": [-1, 1, 3, 6]}]
    }
  }
}
